PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_portal
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads/resumes
MIN_JOB_MATCH_PERCENTAGE=30
