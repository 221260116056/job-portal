{
  "info": {
    "_postman_id": "e4b9dcab-98dd-4c12-a7d4-66ccfe201d10",
    "name": "Job Application Portal API",
    "description": "Candidate (1-9) + company (10-17) flows. Candidate login stores candidateToken, company login stores companyToken. Demo company (after npm run seed): company@example.com / Password@123.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "candidateToken", "value": "" },
    { "key": "companyToken", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "companyJobId", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "item": [
    { "name": "Health Check", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" } },
    { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Vraj Vekariya\",\n  \"email\": \"vraj@example.com\",\n  \"password\": \"Password@123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/register" } },
    { "name": "Login", "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.success && json.data.token) pm.collectionVariables.set('candidateToken', json.data.token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"vraj@example.com\",\n  \"password\": \"Password@123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" } },
    { "name": "Get Profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }], "url": "{{baseUrl}}/api/users/me" } },
    { "name": "Upload Resume", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "resume", "type": "file", "src": "" }] }, "url": "{{baseUrl}}/api/users/resume" } },
    { "name": "Get Skills", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }], "url": "{{baseUrl}}/api/users/skills" } },
    { "name": "Get All Jobs", "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.success && json.data.length) pm.collectionVariables.set('jobId', json.data[0].id);"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/jobs?page=1&limit=10" } },
    { "name": "Get Recommended Jobs", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }], "url": "{{baseUrl}}/api/jobs/recommended" } },
    { "name": "Get Job By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/jobs/{{jobId}}" } },
    { "name": "Apply For Job", "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.success && json.data.id) pm.collectionVariables.set('applicationId', json.data.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"job_id\": \"{{jobId}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/applications" } },
    { "name": "Get My Applications", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }], "url": "{{baseUrl}}/api/applications" } },
    { "name": "Get Application By ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{candidateToken}}" }], "url": "{{baseUrl}}/api/applications/{{applicationId}}" } },
    { "name": "Company Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"company_name\": \"ABC Technologies\",\n  \"email\": \"hr@abc.example.com\",\n  \"password\": \"Password@123\",\n  \"location\": \"Ahmedabad\",\n  \"website\": \"https://example.com\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/company/auth/register" } },
    { "name": "Company Login", "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.success && json.data.token) pm.collectionVariables.set('companyToken', json.data.token);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"company@example.com\",\n  \"password\": \"Password@123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/company/auth/login" } },
    { "name": "Create Job", "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.success && json.data.id) pm.collectionVariables.set('companyJobId', json.data.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{companyToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Backend Developer Intern\",\n  \"description\": \"Work with Node.js APIs and PostgreSQL.\",\n  \"location\": \"Ahmedabad\",\n  \"employment_type\": \"Internship\",\n  \"skills\": [\"Node.js\", \"Express.js\", \"PostgreSQL\"]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/company/jobs" } },
    { "name": "Get Company Jobs", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{companyToken}}" }], "url": "{{baseUrl}}/api/company/jobs" } },
    { "name": "Update Job", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{companyToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Backend Developer Intern\",\n  \"description\": \"Work with Node.js APIs and PostgreSQL. Updated.\",\n  \"location\": \"Ahmedabad\",\n  \"employment_type\": \"Internship\",\n  \"skills\": [\"Node.js\", \"Express.js\", \"PostgreSQL\"]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/company/jobs/{{companyJobId}}" } },
    { "name": "Get Company Applications", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{companyToken}}" }], "url": "{{baseUrl}}/api/company/applications" } },
    { "name": "Update Application Status", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{companyToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"Shortlisted\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/company/applications/{{applicationId}}/status" } },
    { "name": "Delete Job", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{companyToken}}" }], "url": "{{baseUrl}}/api/company/jobs/{{companyJobId}}" } }
  ]
}
